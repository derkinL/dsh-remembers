# companion-memory 环境变量样例
# 复制成 .env 后填，docker compose 会自动读取

# --- embedding（可选，不填就只跑 BM25 关键词检索）---
# 任何 OpenAI 兼容的 /embeddings 端点都行
CMEM_EMBED_BASE=https://your-endpoint/v1
CMEM_EMBED_KEY=sk-xxxx
CMEM_EMBED_MODEL=qwen3.7-text-embedding-flash
CMEM_EMBED_BATCH=16
CMEM_EMBED_TIMEOUT=20

# --- 鉴权（跨机访问必须设）---
# 留空 = 不校验。只绑 127.0.0.1 时可以留空。
CMEM_AUTH_TOKEN=

# --- 对话模型（可选：episode 摘要和自动抽取要它）---
# 只配 embedding 的话，episode 会一直返回 degraded=llm-disabled。
# 任何 OpenAI 兼容的 /chat/completions 端点都行。
# 注意：episode 只要求配了这个，不看 CMEM_EXTRACT 开关。
CMEM_LLM_BASE=https://api.deepseek.com/v1
CMEM_LLM_KEY=sk-xxxx
CMEM_LLM_MODEL=deepseek-flash
CMEM_LLM_TIMEOUT=60

# 自动抽取（逐条事实判定）：默认关，按轮算钱
CMEM_EXTRACT=0

# --- 服务端口 ---
CMEM_PORT=8080
